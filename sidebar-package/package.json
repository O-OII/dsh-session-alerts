{
  "name": "dsh-session-alerts-sidebar",
  "version": "0.3.0",
  "private": true,
  "description": "Local sidebar-only composition of DSH Session Alerts; no native badge engine.",
  "type": "module",
  "license": "MIT",
  "exports": { ".": "./index.mjs", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./package.json": "./package.json" },
  "files": ["index.mjs", "client.js", "completion.mjs", "completion-state.mjs", "completion-contract.mjs", "locale/*.json", "cordis.patch.yml", "LICENSE", "package.json"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
