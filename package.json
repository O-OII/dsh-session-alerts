{
  "name": "dsh-native-taskbar-badge",
  "version": "0.1.1",
  "description": "为 DSH Desktop 主会话显示 Windows 原生 COM 任务栏数字角标；不弹窗、不响铃、不抢焦点、不修改 ASAR。",
  "license": "MIT",
  "author": "O-OII contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/O-OII/dsh-native-taskbar-badge.git"
  },
  "bugs": {
    "url": "https://github.com/O-OII/dsh-native-taskbar-badge/issues"
  },
  "homepage": "https://github.com/O-OII/dsh-native-taskbar-badge#readme",
  "keywords": [
    "dsh",
    "windows",
    "taskbar",
    "badge",
    "accessibility",
    "dsh-plugin"
  ],
  "exports": {
    ".": "./index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "controller.mjs",
    "state.mjs",
    "projection.mjs",
    "paths.mjs",
    "config.mjs",
    "i18n.mjs",
    "native.py",
    "assets/badges/*.ico",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "ASSET-PROVENANCE.md",
    "docs/*.md",
    "docs/images"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "test:python": "python -B -m unittest discover -s test -p test_*.py -v",
    "test:pack": "node --test tools/pack.test.mjs",
    "assets": "python -B tools/generate-assets.py"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
