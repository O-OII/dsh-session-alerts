{
  "name": "dsh-native-taskbar-badge",
  "version": "0.3.0",
  "description": "DSH会话提醒 / DSH Session Alerts：实时未读会话过滤与逐会话已读同步；Windows 原生 COM 任务栏数字角标；不弹窗、不响铃、不抢焦点、不修改 ASAR。",
  "license": "MIT",
  "author": "O-OII contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/O-OII/dsh-session-alerts.git"
  },
  "bugs": {
    "url": "https://github.com/O-OII/dsh-session-alerts/issues"
  },
  "homepage": "https://github.com/O-OII/dsh-session-alerts#readme",
  "keywords": [
    "dsh",
    "windows",
    "taskbar",
    "badge",
    "accessibility",
    "dsh-plugin"
  ],
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./completion": "./completion.mjs",
    "./sidebar-client": "./sidebar-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "bridge.mjs",
    "completion.mjs",
    "completion-state.mjs",
    "completion-contract.mjs",
    "completion-reader.mjs",
    "completed-filter.mjs",
    "unread-filter.mjs",
    "completed-sidebar.mjs",
    "sidebar-messages.mjs",
    "sidebar-client.mjs",
    "sidebar-client.js",
    "sidebar-package/package.json",
    "sidebar-package/index.mjs",
    "sidebar-package/client.js",
    "sidebar-package/completion.mjs",
    "sidebar-package/completion-state.mjs",
    "sidebar-package/completion-contract.mjs",
    "sidebar-package/locale/*.json",
    "sidebar-package/cordis.patch.yml",
    "sidebar-package/LICENSE",
    "client.js",
    "tools/build-client.mjs",
    "tools/generate-assets.py",
    "tools/requirements-assets.txt",
    "client.mjs",
    "read-client.mjs",
    "controller.mjs",
    "state.mjs",
    "projection.mjs",
    "paths.mjs",
    "config.mjs",
    "i18n.mjs",
    "native.py",
    "assets/badges/*.ico",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "ASSET-PROVENANCE.md",
    "docs/*.md",
    "docs/images"
  ],
  "scripts": {
    "build": "node tools/build-client.mjs",
    "test": "node tools/build-client.mjs --check && node --experimental-vm-modules --test test/*.test.mjs",
    "test:python": "python -B -m unittest discover -s test -p test_*.py -v",
    "test:pack": "node --test tools/pack.test.mjs",
    "assets": "python -B tools/generate-assets.py"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
